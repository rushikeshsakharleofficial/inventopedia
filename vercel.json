{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "esbuild packages/api/src/vercel.ts --bundle --platform=node --format=esm --outfile=.generated-api/handler.mjs && npm run build --workspace=packages/web",
  "outputDirectory": "packages/web/dist",
  "routes": [
    { "src": "/api/.*", "dest": "/api/handler" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
